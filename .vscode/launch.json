{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "preLaunchTask": "preRun",
            "name": "ESP32 OpenOCD",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build",
            "program": "${workspaceRoot}/build/IDF_Template.elf",
            "miDebuggerPath": "${env:IDF_TOOLS_PATH}/tools/xtensa-esp32-elf/esp-2022r1-11.2.0/xtensa-esp32-elf/bin/xtensa-esp32-elf-gdb.exe",
            "setupCommands": [
                {"text": "target remote 127.0.0.1:3333"},
                {"text": "set remote hardware-watchpoint-limit 2"},
                {"text": "monitor reset halt"},
                {"text": "flushregs"},
                {"text": "mon program_esp build/bootloader/bootloader.bin 0x1000 verify"},
                {"text": "mon program_esp build/partition_table/partition-table.bin 0x8000 verify"},
                {"text": "mon program_esp build/IDF_Template.bin 0x10000 verify"},
                {"text": "monitor reset halt"},
                {"text": "flushregs"}
            ]
        }
    ]
}